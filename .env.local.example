# Copy to .env.local for local dev, and add the same vars in Vercel → Project → Settings → Environment Variables.
# The site runs WITHOUT these (placeholder content). Fill them in to connect the CMS.

# --- Sanity (from sanity.io/manage → your project) ---
NEXT_PUBLIC_SANITY_PROJECT_ID=
NEXT_PUBLIC_SANITY_DATASET=production
NEXT_PUBLIC_SANITY_API_VERSION=2024-10-01

# --- Site ---
# Your real domain, used for canonical URLs and social share cards.
NEXT_PUBLIC_SITE_URL=https://valeri.example
