# Copy to .env.local for local dev, and add the same vars in Vercel → Project → Settings → Environment Variables.
# The site runs WITHOUT these (placeholder content). Fill them in to connect the CMS.

# --- Sanity (from sanity.io/manage → your project) ---
NEXT_PUBLIC_SANITY_PROJECT_ID=
NEXT_PUBLIC_SANITY_DATASET=production
NEXT_PUBLIC_SANITY_API_VERSION=2024-10-01

# --- Glofox (booking + payments) ---
# From Glofox dashboard → Settings → Integrations → Website Integration.
# Set the branch id to switch /pricing and /book from the placeholder/preview
# to the live embedded Glofox blocks. The API key is only needed if Glofox's
# snippet shows one.
NEXT_PUBLIC_GLOFOX_BRANCH_ID=
NEXT_PUBLIC_GLOFOX_API_KEY=

# --- Site ---
# Your real domain, used for canonical URLs and social share cards.
NEXT_PUBLIC_SITE_URL=https://valeri.example
